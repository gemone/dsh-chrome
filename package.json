{
  "name": "@gemone/dsh-chrome",
  "version": "0.6.0",
  "description": "DeepSeek Harness plugin: model-facing tools that drive a real Chrome browser over the Chrome DevTools Protocol (CDP).",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./reading": "./lib/reading.js",
    "./reading/locale/*.json": "./locale/reading/*.json",
    "./interact": "./lib/interact.js",
    "./interact/locale/*.json": "./locale/interact/*.json",
    "./capture": "./lib/capture.js",
    "./capture/locale/*.json": "./locale/capture/*.json",
    "./observatory": "./lib/observatory.family.js",
    "./observatory/locale/*.json": "./locale/observatory/*.json",
    "./session": "./lib/session.js",
    "./session/locale/*.json": "./locale/session/*.json",
    "./observatory/types": "./lib/observatory.family.d.ts"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "DSH_CHROME_INTEGRATION=1 vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "chrome",
    "devtools",
    "cdp",
    "browser-automation",
    "agent-tool"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gemone/dsh-chrome.git"
  },
  "homepage": "https://github.com/gemone/dsh-chrome#readme",
  "bugs": {
    "url": "https://github.com/gemone/dsh-chrome/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20",
    "dsh": "^0.2.2-rc.5"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-attachment": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-util-values": "^0.2.2-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-attachment": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-util-values": "^0.2.2-rc.5",
    "@types/ws": "^8.5.13",
    "tsdown": "^0.11.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0",
    "@deepseek-ai/dsh-tool-executor-native": "^0.2.2-rc.5",
    "@deepseek-ai/cordis-plugin-loader": "^1.1.0"
  }
}
